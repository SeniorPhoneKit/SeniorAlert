<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms: USE_EXACT_ALARM is auto-granted to alarm-clock apps on API 33+;
         SCHEDULE_EXACT_ALARM covers API 31-32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "Display over other apps": lets RingService open the ring screen while the phone
         is in use (a full-screen intent is then only a heads-up). Granted by the helper. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Android 11+ only lets us see other apps' providers if we say we look for them. -->
    <queries>
        <provider android:authorities="app.phueber.seniorlauncher.lock" />
        <!-- SeniorNav's bar state, so our Back button hides exactly while its bar shows. -->
        <provider android:authorities="app.phueber.seniornav.bar" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen ringing screen; must work over the lock screen and before
             the first unlock after a reboot. -->
        <activity
            android:name=".RingActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/RingTheme"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <service
            android:name=".RingService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".AlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Backup stop: fires ~2 minutes after ringing starts, independent of the
             service's own timer, so ringing can never outlive its limit. -->
        <receiver
            android:name=".StopReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Commands from automation apps (Trigly, Tasker, ...): explicit broadcasts
             with string extras, see Automation. Exported on purpose; nothing here
             needs a permission the sender would lack. -->
        <receiver
            android:name=".AutomationReceiver"
            android:directBootAware="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.phueber.senioralert.action.ALARM_ON" />
                <action android:name="app.phueber.senioralert.action.ALARM_OFF" />
                <action android:name="app.phueber.senioralert.action.ALARM_SET" />
                <action android:name="app.phueber.senioralert.action.ALARM_DELETE" />
                <action android:name="app.phueber.senioralert.action.STOP" />
                <action android:name="app.phueber.senioralert.action.LOCK" />
                <action android:name="app.phueber.senioralert.action.UNLOCK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: next alarm, or the alarm list when made bigger.
             Read-only, a tap opens the app. Reads device-protected Store, so it is
             drawn before the first unlock too. -->
        <receiver
            android:name=".AlarmWidget"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget" />
        </receiver>
        <!-- Save and load the alarms for SeniorLauncher's backup of every Senior
             app; answers only SeniorLauncher and this app, see BackupProvider. -->
        <provider
            android:name=".BackupProvider"
            android:authorities="app.phueber.senioralert.backup"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>

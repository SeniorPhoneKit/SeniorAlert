<?xml version="1.0" encoding="utf-8"?>
<!-- One alarm in the wide face, on one line: time, the day it rings (ON only) and
     ON/OFF in words. AlarmWidget sets the colours. Texts shrink to fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_margin="2dp"
    android:layout_weight="1"
    android:background="@drawable/widget_row_off"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/row_time"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:textColor="@color/widget_off_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_day"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="4dp"
        android:textColor="@color/widget_off_text" />

    <TextView
        android:id="@+id/row_state"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:autoSizeMaxTextSize="32sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:textColor="@color/widget_off_text"
        android:textStyle="bold" />
</LinearLayout>
